[Unit]
Description=PumpAPI (pump.fun) near-real-time websocket ingestor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/databricks-lab/ingestion/pumpfun
EnvironmentFile=/opt/databricks-lab/ingestion/pumpfun/.env
ExecStart=/opt/databricks-lab/ingestion/pumpfun/venv/bin/python -m app.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

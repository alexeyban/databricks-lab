# PumpAPI (pump.fun) websocket ingestor — environment configuration.
# Copy to .env in this directory and fill in the Databricks values.

PUMPAPI_WS_URL=wss://stream.pumpapi.io/

OUTPUT_DIR=./data/pumpapi

# Batching: events are buffered and flushed to a JSONL file when either
# threshold is hit.
BATCH_SIZE=5000
FLUSH_INTERVAL_SECONDS=25

# WebSocket reconnect / keepalive
RECONNECT_DELAY_SECONDS=5
PING_INTERVAL_SECONDS=20
PING_TIMEOUT_SECONDS=20

SOURCE_NAME=pumpapi

# Databricks — used to upload completed JSONL files to a Unity Catalog Volume
# via the Files API. This volume is what the pumpfun-bronze Databricks job
# (ingestion/consumers/NB_ingest_pumpfun_to_bronze) streams from.
DATABRICKS_HOST=https://dbc-XXXXXXXXXXXXX.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_VOLUME_PATH=/Volumes/workspace/default/mnt/pumpapi

UPLOAD_INTERVAL_SECONDS=10
